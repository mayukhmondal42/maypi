<% layout("/layouts/boilerplate") %>

    <div class="row mt-3">
        <div class="col-6 offset-3">

            <h3>
                <%= listing.title %>
            </h3>

            <div class="card show-card mt-3">

                <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">

                <div class="card-body">

                    <p class="card-text">
                        <%= listing.description %>
                    </p>

                    <p class="card-text">
                        <b>&#8377; <%= listing.price.toLocaleString("en-IN") %></b> / night
                    </p>

                    <p class="card-text">
                        <%= listing.location %>, <%= listing.country %>
                    </p>

                </div>
            </div>

            <div class="mt-3">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger edit-btn">
                    Edit
                </a>

                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                    <button class="btn btn-dark delete-btn">
                        Delete
                    </button>
                </form>
            </div>

        </div>
    </div>
