<%- layout("/layouts/boilerplate") %>



<div class="row mt-2 mb-5">
    <h1 class="col-8 offset-3">SignUp on Wanderlust</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="POST" class="needs-validation" novalidate>
            <div class="mb-2">
                <label for="username" class="form-label">Username</label>
                <input type="text" id="title" name="username" class="form-control" id="username" required>
                <div class="valid-feedback">Looks good!</div>
            </div>

            <div class="mb-2">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="email" name="email" class="form-control" id="username" required>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" class="form-control" id="username" required>
            </div>

            <button class="btn btn-success">SignUp</button>

        </form>
    </div>
</div>